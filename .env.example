# Copy to .env in this folder (never commit .env)

NODE_ENV=development
PORT=5000

# MongoDB Atlas: Database → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clearclever?retryWrites=true&w=majority

# Auth (generate a long random string, min 32 chars)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Local dev without Gmail: returns OTP in API response (development only)
OTP_DEBUG=true

# Comma-separated frontend URLs (add Vercel URL when deployed)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Public URLs for affiliate redirect + post-purchase return (required on Render)
# Use full https:// URLs in production. Host-only values work too (https is added automatically).
CLIENT_URL=https://clearclever.vercel.app
API_PUBLIC_URL=http://localhost:5000

# Optional: override default seed password (default: password)
# SEED_PASSWORD=

# Gmail SMTP (works locally; blocked on Render FREE tier — use Brevo there)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.project.gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=ClearClever <your.project.gmail@gmail.com>

# Brevo HTTPS email (recommended on Render free tier — 300 emails/day free)
# https://www.brevo.com → verify your Gmail as a sender → API Keys
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=your.project.gmail@gmail.com
# BREVO_SENDER_NAME=ClearClever

# Support contact form inbox (defaults to syedzurainrizvi@gmail.com)
# SUPPORT_INBOX_EMAIL=syedzurainrizvi@gmail.com

# --- Agent memory (Mem0 → Qdrant) — optional until memory service is wired ---
# QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=clearclever_memories
# MEM0_USER_ID=dev-local
# Google Gemini — AI assistant (backend only; never expose in frontend)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=1024
# GEMINI_UPSTREAM_RPM=4
# GEMINI_UPSTREAM_RPD=18
# ASSISTANT_RATE_LIMIT_PER_MIN=4

# OPENAI_API_KEY=          # Mem0 embedder/extraction default
# ANTHROPIC_API_KEY=       # if Mem0 llm provider set to anthropic for backend agent
